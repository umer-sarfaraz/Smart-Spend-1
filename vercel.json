{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gemini.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/guides/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pennyroost.com" }],
      "destination": "/home.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "pennyroost.com" }],
      "destination": "/home.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/join/:code",
      "destination": "/join.html"
    },
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "pennyroost.com" }],
      "destination": "/home.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
